# Use PAPER account credentials only. Do not paste real values into this file.
ALPACA_API_KEY=replace_with_paper_key
ALPACA_SECRET_KEY=replace_with_paper_secret
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex

# Optional CrewAI commentary. If unset, the CLI produces deterministic-only reports.
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434
# For a LiteLLM-compatible cloud provider, set LLM_PROVIDER=cloud,
# LLM_MODEL=openai/gpt-4o-mini (or another supported model), and LLM_API_KEY.
# Do not put real credentials in this file.
